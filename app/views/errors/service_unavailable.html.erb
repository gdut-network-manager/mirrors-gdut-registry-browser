<div class="island error-page">
  <%= render "shared/icon", name: "alert", size: 64, class: "error-icon" %>
  <h1 class="error-code">502</h1>
  <p class="error-title">服务不可用</p>
  <p class="error-desc">无法连接到 Harbor 服务，请稍后重试。如果问题持续存在，请联系管理员检查 Harbor 服务状态。</p>
  <%= link_to root_path, class: "error-back" do %>
    <%= render "shared/icon", name: "home", size: 18 %>
    返回首页
  <% end %>
</div>
