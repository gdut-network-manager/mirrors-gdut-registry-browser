<% total_pages = local_assigns[:total_pages] || 1 %>
<% current_page = local_assigns[:current_page] || 1 %>
<% path_helper = local_assigns[:path_helper] %>
<% path_args = local_assigns[:path_args] || {} %>

<% if total_pages > 1 %>
  <div class="pagination">
    <% if current_page > 1 %>
      <%= link_to "‹", send(path_helper, **path_args, page: current_page - 1) %>
    <% else %>
      <span class="disabled">‹</span>
    <% end %>

    <%
      window = 2
      start_page = [current_page - window, 1].max
      end_page = [current_page + window, total_pages].min

      pages = (1..total_pages).to_a.select do |p|
        p == 1 || p == total_pages || (p >= start_page && p <= end_page)
      end

      prev = nil
    %>

    <% pages.each do |p| %>
      <% if prev && p > prev + 1 %>
        <span class="gap">…</span>
      <% end %>
      <% if p == current_page %>
        <span class="current"><%= p %></span>
      <% else %>
        <%= link_to p, send(path_helper, **path_args, page: p) %>
      <% end %>
      <% prev = p %>
    <% end %>

    <% if current_page < total_pages %>
      <%= link_to "›", send(path_helper, **path_args, page: current_page + 1) %>
    <% else %>
      <span class="disabled">›</span>
    <% end %>
  </div>
<% end %>
