<div class="justify-content-center">
  <div class="col-md-6">
    <%= render "breadcrumb" %>

    <div class="island mb-5">
      <%= content_tag :div, class: "island-header" do %>
        <%= render "shared/icon", name: "package", size: 32, class: "island-icon" %>
        <div class="island-header-group">
          <span class="text-muted small">代理项目</span>
          <h5 class="island-title mb-0"><%= @project.name %></h5>
        </div>
        <div class="island-header-group">
          <span class="text-muted small">仓库</span>
          <h5 class="island-title mb-0"><%= @repository.relative_name %></h5>
        </div>
      <% end %>

      <div class="island-body">
        <div class="nav-tabs">
          <button type="button" class="nav-tab <% unless params[:tab] == "description" %>active<% end %>" data-tab="artifacts" onclick="switchRepoTab('artifacts')">
            <%= render "shared/icon", name: "layers", size: 16 %>
            制品列表
          </button>
          <button type="button" class="nav-tab <% if params[:tab] == "description" %>active<% end %>" data-tab="description" onclick="switchRepoTab('description')">
            <%= render "shared/icon", name: "info", size: 16 %>
            描述信息
          </button>
        </div>

        <div class="tab-content <% unless params[:tab] == "description" %>active<% end %>" id="tab-artifacts">
          <% if @tags.any? %>
            <input type="text" id="tag-filter" class="form-control mb-3" placeholder="过滤标签…" onkeyup="filterTags()">
            <div class="list-group list-group-flush" id="tag-list">
              <% @tags.each do |tag| %>
                <div class="tag-entry d-flex align-items-center">
                  <%= link_to tag_path(@project.name, @repository.relative_name, tag.name), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center flex-grow-1" do %>
                    <div class="flex-grow-1 d-flex align-items-center gap-2">
                      <%= content_tag :span, "标签", class: "badge badge-dtag text-uppercase mr-1" %>
                      <span class="text-monospace small"><%= tag.name %></span>
                      <% if tag.display_type %>
                        <span class="artifact-type-badge">
                          <%= render "shared/icon", name: tag.type_icon, size: 14 %>
                          <%= tag.display_type %>
                        </span>
                      <% end %>
                    </div>
                    <%= render "shared/icon", name: "arrow-right", size: 16 %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <%= render "blank_tags" %>
          <% end %>
        </div>

        <div class="tab-content <% if params[:tab] == "description" %>active<% end %>" id="tab-description">
          <% if @repository.has_description? %>
            <div class="markdown-body">
              <%= render_markdown(@repository.description) %>
            </div>
          <% else %>
            <div class="empty-state">
              <%= render "shared/icon", name: "info", size: 48, class: "empty-state-icon" %>
              <p class="text-muted">暂无描述</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <% unless params[:tab] == "description" %>
      <%= render "shared/pagination", total_pages: @tags_collection.total_pages, current_page: @tags_collection.page, path_helper: :repository_path, path_args: { project_name: @project.name, repo: @repository.relative_name } %>
    <% end %>
  </div>
</div>

<script>
function switchRepoTab(tab) {
  document.querySelectorAll('.nav-tab').forEach(function(t) { t.classList.remove('active'); });
  document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.remove('active'); });

  document.querySelector('.nav-tab[data-tab="' + tab + '"]').classList.add('active');
  document.getElementById('tab-' + tab).classList.add('active');
}

function filterTags() {
  var input = document.getElementById("tag-filter");
  var filter = input.value.toLowerCase();
  var entries = document.getElementById("tag-list").getElementsByClassName("tag-entry");
  for (var i = 0; i < entries.length; i++) {
    var text = entries[i].textContent || entries[i].innerText;
    if (text.toLowerCase().indexOf(filter) > -1) {
      entries[i].style.display = "";
    } else {
      entries[i].style.display = "none";
    }
  }
}
</script>
