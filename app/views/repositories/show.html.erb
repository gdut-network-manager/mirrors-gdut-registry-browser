<div class="justify-content-center">
  <div class="col-md-6">
    <%= render "breadcrumb" %>

    <div class="island mb-5">
      <%= content_tag :div, class: "island-header" do %>
        <%= render "shared/icon", name: "package", size: 32, class: "island-icon" %>
        <div class="island-header-group">
          <span class="text-muted small"><%= @project.proxy_cache? ? "代理项目" : "本地项目" %></span>
          <h5 class="island-title mb-0"><%= @project.name %></h5>
        </div>
        <div class="island-header-group">
          <span class="text-muted small">仓库</span>
          <h5 class="island-title mb-0"><%= @repository.relative_name %></h5>
        </div>
      <% end %>

      <div class="island-body">
        <div class="nav-tabs">
          <button type="button" class="nav-tab <% unless params[:tab] == "description" %>active<% end %>" data-tab="artifacts" onclick="switchRepoTab('artifacts')">
            <%= render "shared/icon", name: "layers", size: 16 %>
            制品列表
          </button>
          <button type="button" class="nav-tab <% if params[:tab] == "description" %>active<% end %>" data-tab="description" onclick="switchRepoTab('description')">
            <%= render "shared/icon", name: "info", size: 16 %>
            描述信息
          </button>
        </div>

        <div class="tab-content <% unless params[:tab] == "description" %>active<% end %>" id="tab-artifacts">
          <% if @tags.any? %>
            <input type="text" id="tag-filter" class="form-control mb-3" placeholder="过滤标签…" onkeyup="filterTags()">
            <div class="repo-table-wrap" id="tag-list">
              <table class="repo-table artifact-table">
                <thead>
                  <tr>
                    <th>制品 (Digest)</th>
                    <th>标签</th>
                    <th>类型</th>
                    <th>大小</th>
                    <th>漏洞</th>
                    <th>推送时间</th>
                    <th class="artifact-col-time">拉取时间</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% @tags.each do |tag| %>
                    <%
                      scan = tag.artifact.scan_summary
                      fmt = ->(t) { t ? Time.parse(t.to_s).strftime("%Y-%m-%d %H:%M") : "—" }
                    %>
                    <tr>
                      <td class="artifact-col-digest">
                        <span class="cell-with-copy">
                          <%= link_to tag_path(@project.name, @repository.relative_name, tag.reference), class: "text-monospace small" do %>
                            <span title="<%= tag.content_digest %>"><%= tag.content_digest.to_s.delete_prefix("sha256:")[0, 12] %></span>
                          <% end %>
                          <button type="button" class="copy-inline-btn" data-copy-text="<%= tag.content_digest %>" title="复制 Digest">
                            <%= render "shared/icon", name: "copy", size: 13 %>
                          </button>
                        </span>
                        <% if tag.display_type %>
                          <span class="artifact-type-badge">
                            <%= render "shared/icon", name: tag.type_icon, size: 13 %>
                            <%= tag.display_type %>
                          </span>
                        <% end %>
                      </td>
                      <td class="artifact-col-tags">
                        <% if tag.name %>
                          <span class="cell-with-copy">
                            <span class="text-monospace small"><%= tag.name %></span>
                            <button type="button" class="copy-inline-btn" data-copy-text="<%= tag.name %>" title="复制标签">
                              <%= render "shared/icon", name: "copy", size: 13 %>
                            </button>
                          </span>
                        <% else %>
                          <span class="text-muted">—</span>
                        <% end %>
                      </td>
                      <td><%= number_to_human_size(tag.size) %></td>
                      <td class="artifact-col-vuln">
                        <% if scan.nil? || scan[:status] != "Success" %>
                          <span class="text-muted"><%= scan.nil? ? "未扫描" : format_scan_status(scan[:status]) %></span>
                        <% else %>
                          <span class="vuln-cell">
                            <% scan[:details].each do |sev, count| %>
                              <span class="vuln-count" style="color: <%= vuln_severity_color(sev) %>" title="<%= vuln_severity_label(sev) %>"><%= count %></span>
                            <% end %>
                            <% if scan[:details].empty? %>
                              <span class="vuln-count vuln-clean">0</span>
                            <% end %>
                          </span>
                        <% end %>
                      </td>
                      <td><%= fmt.(tag.push_time) %></td>
                      <td class="artifact-col-time"><%= fmt.(tag.pull_time) %></td>
                      <td><%= render "shared/icon", name: "arrow-right", size: 15 %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <%= render "blank_tags" %>
          <% end %>
        </div>

        <div class="tab-content <% if params[:tab] == "description" %>active<% end %>" id="tab-description">
          <% if @repository.has_description? %>
            <div class="markdown-body">
              <%= render_markdown(@repository.description) %>
            </div>
          <% else %>
            <div class="empty-state">
              <%= render "shared/icon", name: "info", size: 48, class: "empty-state-icon" %>
              <p class="text-muted">暂无描述</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <% unless params[:tab] == "description" %>
      <div id="tag-pagination" <%= 'hidden' if @tags_collection.total_pages <= 1 %>>
        <%= render "shared/pagination", total_pages: @tags_collection.total_pages, current_page: @tags_collection.page, path_helper: :repository_path, path_args: { project_name: @project.name, repo: @repository.relative_name } %>
      </div>
    <% end %>
  </div>
</div>

<script>
function switchRepoTab(tab) {
  document.querySelectorAll('.nav-tab').forEach(function(t) { t.classList.remove('active'); });
  document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.remove('active'); });

  document.querySelector('.nav-tab[data-tab="' + tab + '"]').classList.add('active');
  document.getElementById('tab-' + tab).classList.add('active');
}

function filterTags() {
  var input = document.getElementById("tag-filter");
  var filter = input.value.toLowerCase();
  var rows = document.getElementById("tag-list").querySelectorAll("tbody tr");
  var visibleCount = 0;
  for (var i = 0; i < rows.length; i++) {
    var text = rows[i].textContent || rows[i].innerText;
    if (text.toLowerCase().indexOf(filter) > -1) {
      rows[i].style.display = "";
      visibleCount++;
    } else {
      rows[i].style.display = "none";
    }
  }
  var pagination = document.getElementById("tag-pagination");
  if (pagination) {
    pagination.hidden = filter !== "" || !pagination.querySelector(".pagination");
  }
}

document.addEventListener("click", function(e) {
  var btn = e.target.closest(".copy-inline-btn");
  if (!btn) return;
  e.preventDefault();
  e.stopPropagation();
  var text = btn.getAttribute("data-copy-text");
  if (!text) return;
  var self = btn;
  navigator.clipboard.writeText(text).then(function() {
    self.classList.add("copied");
    setTimeout(function() { self.classList.remove("copied"); }, 1500);
  });
});
</script>
