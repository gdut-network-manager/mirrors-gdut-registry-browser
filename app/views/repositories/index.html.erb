<div class="justify-content-center">
  <div class="col-md-6">
    <%= render "breadcrumb" %>

    <div class="island mb-5">
      <%= content_tag :div, class: "island-header" do %>
        <%= render "shared/icon", name: "server", size: 28, class: "island-icon" %>
        <div class="island-header-group">
          <span class="text-muted small">代理项目</span>
          <h5 class="island-title mb-0"><%= @project.name %></h5>
        </div>
        <% if @project.upstream_registry %>
          <div class="island-header-group" style="margin-left: auto;">
            <span class="badge badge-dtag"><%= @project.upstream_registry.display_name %></span>
          </div>
        <% end %>
      <% end %>

      <% if @repositories.any? %>
        <div class="island-body">
          <div class="list-group list-group-flush">
            <% @repositories.each do |repo| %>
              <%= link_to repository_path(@project.name, repo.relative_name), class: "list-group-item list-group-item-action d-flex align-items-center" do %>
                <div class="flex-grow-1">
                  <span class="badge badge-dimage text-uppercase mr-1">IMG</span>
                  <span class="text-monospace small text-truncate"><%= repo.relative_name %></span>
                </div>
                <span class="badge badge-dtag mr-2"><%= repo.artifact_count %> 镜像</span>
                <%= render "shared/icon", name: "arrow-right", size: 16 %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% else %>
        <%= render "blank" %>
      <% end %>
    </div>

    <%= render "shared/pagination", total_pages: @repositories.total_pages, current_page: @repositories.page, path_helper: :project_path, path_args: { project_name: @project.name } %>
  </div>
</div>
