<div class="history-table-wrapper">
  <table class="history-table">
    <thead>
      <tr>
        <th class="history-th-time">时间</th>
        <th class="history-th-cmd">构建命令</th>
        <th class="history-th-comment">注释</th>
      </tr>
    </thead>
    <tbody>
      <% manifest.history.each do |entry| %>
        <tr class="history-row">
          <td class="history-td-time"><%= entry.created %></td>
          <td class="history-td-cmd"><%= entry.created_by %></td>
          <td class="history-td-comment"><%= entry.comment.present? ? entry.comment : "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
