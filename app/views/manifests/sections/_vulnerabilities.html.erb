<% if manifest.scan_overview.nil? %>
  <div class="empty-state">
    <%= render "shared/icon", name: "shield", size: 48, class: "empty-state-icon" %>
    <p>无扫描结果</p>
  </div>
<% elsif manifest.scan_status && manifest.scan_status != "Success" %>
  <div class="empty-state">
    <% if manifest.scan_status == "Running" || manifest.scan_status == "Pending" %>
      <%= render "shared/icon", name: "loader", size: 48, class: "empty-state-icon" %>
      <p>扫描进行中<% if manifest.scan_complete_percent && manifest.scan_complete_percent < 100 %> (<%= manifest.scan_complete_percent %>%)<% end %></p>
    <% elsif manifest.scan_status == "Error" %>
      <%= render "shared/icon", name: "alert", size: 48, class: "empty-state-icon" %>
      <p>扫描失败</p>
    <% else %>
      <%= render "shared/icon", name: "info", size: 48, class: "empty-state-icon" %>
      <p><%= format_scan_status(manifest.scan_status) %></p>
    <% end %>
  </div>
<% else %>
  <div class="vuln-section">
    <div class="vuln-summary">
      <div class="vuln-summary-stats">
        <span class="vuln-summary-total">共 <%= manifest.vuln_total %> 个漏洞</span>
        <% if manifest.vuln_fixable > 0 %>
          <span class="vuln-summary-fixable">
            <%= render "shared/icon", name: "wrench", size: 14 %>
            <%= manifest.vuln_fixable %> 个可修复
          </span>
        <% end %>
        <% if manifest.scan_scanner %>
          <span class="vuln-summary-scanner">
            扫描器: <%= manifest.scan_scanner["name"] %> <%= manifest.scan_scanner["version"] %>
          </span>
        <% end %>
      </div>
    </div>

    <%= turbo_frame_tag "vuln-frame-#{manifest.id}", src: tag_vulnerabilities_path(project_name: @project.name, repo: @repository.relative_name, tag: @tag.name, manifest_id: manifest.id, artifact_digest: manifest.artifact_digest) do %>
      <div class="vuln-loading">
        <%= render "shared/icon", name: "loader", size: 24 %>
        <span>加载漏洞列表中...</span>
      </div>
    <% end %>
  </div>
<% end %>
