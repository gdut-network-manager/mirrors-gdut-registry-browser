<% if manifest.layers.any? %>
  <%- total_size = manifest.layers.sum(&:size) %>

  <h5 class="mt-4">层信息</h5>
  <div class="layer-table-wrapper">
    <table class="layer-table">
      <thead>
        <tr>
          <th class="layer-th-index">#</th>
          <th class="layer-th-digest">Digest</th>
          <th class="layer-th-size">大小</th>
          <th class="layer-th-bar">占比</th>
        </tr>
      </thead>
      <tbody>
        <% manifest.layers.each_with_index do |layer, index| %>
          <%- percent = total_size > 0 ? (layer.size.to_f / total_size * 100).round(2) : 0 %>
          <tr>
            <td class="layer-td-index"><%= index + 1 %></td>
            <td class="layer-td-digest" title="<%= layer.digest %>"><%= layer.digest %></td>
            <td class="layer-td-size"><%= bytes_to_human(layer.size) %></td>
            <td class="layer-td-bar">
              <div class="layer-progress">
                <div class="layer-progress-fill" style="width: <%= percent %>%"></div>
              </div>
              <span class="layer-progress-text"><%= percent %>%</span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <hr />
<% end %>
