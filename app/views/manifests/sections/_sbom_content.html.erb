<% if packages.nil? || packages.empty? %>
  <div class="empty-state">
    <%= render "shared/icon", name: "list", size: 48, class: "empty-state-icon" %>
    <p>该制品不支持 SBOM 生成</p>
  </div>
<% else %>
  <div class="sbom-content">
    <div class="sbom-search-box">
      <span class="sbom-search-icon">
        <%= render "shared/icon", name: "search", size: 16 %>
      </span>
      <input type="text"
             class="sbom-search-input"
             placeholder="搜索包名..."
             data-sbom-search="<%= manifest_id %>">
      <span class="sbom-count"><%= packages.size %> 个包</span>
    </div>

    <div class="sbom-table-wrapper" data-sbom-table="<%= manifest_id %>">
      <table class="sbom-table">
        <thead>
          <tr>
            <th>包名</th>
            <th>版本</th>
            <th>许可证</th>
            <th>类型</th>
          </tr>
        </thead>
        <tbody>
          <% packages.sort_by { |p| p["name"].to_s }.each do |pkg| %>
            <tr class="sbom-row" data-sbom-pkg="<%= pkg["name"].to_s.downcase %>">
              <td class="sbom-pkg-name"><%= pkg["name"] %></td>
              <td class="sbom-pkg-version"><%= sbom_version_display(pkg["versionInfo"]) %></td>
              <td class="sbom-pkg-license"><%= sbom_license_display(pkg["licenseConcluded"]) %></td>
              <td class="sbom-pkg-type"><%= pkg["primaryPackagePurpose"] || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="sbom-no-results" data-sbom-no-results="<%= manifest_id %>" style="display: none;">
      <p>未找到匹配的包</p>
    </div>
  </div>
<% end %>
