<% if packages.nil? || packages.empty? %>
  <div class="empty-state">
    <%= render "shared/icon", name: "list", size: 48, class: "empty-state-icon" %>
    <p>该制品不支持 SBOM 生成</p>
  </div>
<% else %>
  <% sorted_packages = packages.sort_by { |p| p["name"].to_s } %>
  <div class="sbom-content">
    <div class="sbom-toolbar">
      <span class="sbom-count"><%= packages.size %> 个包</span>
      <div class="sbom-search-box">
        <span class="sbom-search-icon">
          <%= render "shared/icon", name: "search", size: 16 %>
        </span>
        <input type="text"
               class="sbom-search-input"
               placeholder="搜索包名..."
               data-sbom-search="<%= manifest_id %>">
      </div>
    </div>

    <div class="sbom-table-wrapper" data-sbom-table="<%= manifest_id %>">
      <table class="sbom-table" data-sortable-table="<%= manifest_id %>">
        <thead>
          <tr>
            <th class="sortable-th sorted-asc" data-sort-key="name" data-sort-type="string">包名 <span class="sort-icon"></span></th>
            <th class="sortable-th" data-sort-key="version" data-sort-type="string">版本 <span class="sort-icon"></span></th>
            <th class="sortable-th" data-sort-key="license" data-sort-type="string">许可证 <span class="sort-icon"></span></th>
            <th class="sortable-th" data-sort-key="type" data-sort-type="string">类型 <span class="sort-icon"></span></th>
          </tr>
        </thead>
        <tbody>
          <% sorted_packages.each do |pkg| %>
            <tr class="sbom-row" data-sbom-pkg="<%= pkg["name"].to_s.downcase %>">
              <td class="sbom-pkg-name" data-sort-value="<%= pkg["name"].to_s %>"><%= pkg["name"] %></td>
              <td class="sbom-pkg-version" data-sort-value="<%= pkg["versionInfo"].to_s %>"><%= sbom_version_display(pkg["versionInfo"]) %></td>
              <td class="sbom-pkg-license" data-sort-value="<%= pkg["licenseConcluded"].to_s %>"><%= sbom_license_display(pkg["licenseConcluded"]) %></td>
              <td class="sbom-pkg-type" data-sort-value="<%= pkg["primaryPackagePurpose"].to_s %>"><%= pkg["primaryPackagePurpose"] || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="pagination-bar" data-sbom-pagination="<%= manifest_id %>">
      <span class="pagination-info">
        <span class="pagination-range">0-0</span> / <span class="pagination-total"><%= packages.size %></span>
      </span>
      <div class="pagination-controls">
        <button class="pagination-btn pagination-prev" disabled>上一页</button>
        <span class="pagination-pages"></span>
        <button class="pagination-btn pagination-next" disabled>下一页</button>
      </div>
    </div>

    <div class="sbom-no-results" data-sbom-no-results="<%= manifest_id %>" style="display: none;">
      <p>未找到匹配的包</p>
    </div>
  </div>
<% end %>
