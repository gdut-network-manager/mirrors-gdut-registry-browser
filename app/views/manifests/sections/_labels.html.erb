<% if manifest.labels.any? %>
  <h5 class="mt-4">标签（Labels）</h5>
  <div class="info-table-wrapper">
    <table class="info-table">
      <thead>
        <tr>
          <th class="info-th-key">键</th>
          <th class="info-th-value">值</th>
        </tr>
      </thead>
      <tbody>
        <% manifest.labels.each do |key, value| %>
          <tr>
            <td class="info-td-key"><%= key %></td>
            <td class="info-td-value"><%= value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <hr />
<% end %>
