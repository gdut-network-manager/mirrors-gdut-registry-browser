<% if manifest.labels.any? %>
  <h5 class="mt-4">标签（Labels）</h5>
  <div class="labels-table">
    <% manifest.labels.each do |key, value| %>
      <div class="labels-row">
        <span class="labels-key text-monospace small"><span class="badge-pill badge-dlayer"><%= key %></span></span>
        <span class="labels-value text-monospace small"><%= value %></span>
      </div>
    <% end %>
  </div>

  <hr />
<% end %>
