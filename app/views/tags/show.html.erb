<div style="max-width: 900px; margin: 0 auto;">
  <%= render "breadcrumb" %>

  <div class="island">
    <div class="island-header">
      <%= render "shared/icon", name: "tag", size: 32, class: "island-icon" %>

      <div class="island-header-group">
        <span class="text-muted small"><%= @project.proxy_cache? ? "代理项目" : "本地项目" %></span>
        <h5 class="island-title"><%= @project.name %></h5>
      </div>

      <div class="island-header-group">
        <span class="text-muted small">仓库 / <% if @tag.name %>标签<% else %>Digest<% end %></span>
        <h5 class="island-title"><%= @repository.relative_name %><% if @tag.name %>:<%= @tag.name %><% else %>@<%= @tag.display_name %><% end %></h5>
      </div>

      <% if @tag.display_type %>
        <div class="island-header-group" style="margin-left: auto;">
          <span class="artifact-type-badge">
            <%= render "shared/icon", name: @tag.type_icon, size: 16 %>
            <%= @tag.display_type %>
          </span>
        </div>
      <% end %>
    </div>

    <% if Rails.configuration.x.public_registry_url %>
      <div class="pull-cmd-section">
      <div class="pull-cmd-header">
        <span class="pull-cmd-label">拉取命令</span>
        <div class="pull-cmd-toggle<%= ' disabled' unless @project.proxy_cache? %>">
          <span class="toggle-label active" id="toggle-label-prefix" onclick="switchPullCmd(false)">前缀添加模式</span>
          <div class="pull-cmd-switch" id="pull-cmd-switch"<%= ' disabled' unless @project.proxy_cache? %> onclick="togglePullCmd()">
            <div class="toggle-knob"></div>
          </div>
          <span class="toggle-label" id="toggle-label-mirror"<%= ' onclick="switchPullCmd(true)"'.html_safe if @project.proxy_cache? %>>域名置换模式</span>
        </div>
      </div>
      <div class="pull-cmd-display">
        <code class="pull-cmd-text" id="pull-cmd-prefix"><%= pull_command_prefix(@project.name, @repository.relative_name, @tag.name, @tag.content_digest) %></code>
        <code class="pull-cmd-text hidden" id="pull-cmd-mirror"><%= pull_command_mirror(@project, @repository.relative_name, @tag.name, @tag.content_digest) %></code>
          <%= link_to "#copy", title: "复制到剪贴板", data: { copy: pull_command_prefix(@project.name, @repository.relative_name, @tag.name, @tag.content_digest), tooltip: "复制到剪贴板" } do %>
            <%= render "shared/icon", name: "copy", size: 16 %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="island-body">
      <div class="nav-tabs">
        <% @tag.manifests.each do |manifest| %>
          <a class="nav-tab <% if @tag.manifests.first == manifest %>active<% end %>" href="#<%= manifest.id %>" onclick="
            document.querySelectorAll('.nav-tab').forEach(function(t) { t.classList.remove('active'); });
            document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.remove('active'); });
            this.classList.add('active');
            document.getElementById('<%= manifest.id %>').classList.add('active');
            return false;
          ">
            <%= manifest.os %> / <%= manifest.architecture %>
          </a>
        <% end %>
      </div>

      <% @tag.manifests.each do |manifest| %>
        <div class="tab-content <% if @tag.manifests.first == manifest %>active<% end %>" id="<%= manifest.id %>">
          <%= render manifest %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
function switchPullCmd(toMirror) {
  var switchEl = document.getElementById('pull-cmd-switch');
  var prefixLabel = document.getElementById('toggle-label-prefix');
  var mirrorLabel = document.getElementById('toggle-label-mirror');
  var prefixEl = document.getElementById('pull-cmd-prefix');
  var mirrorEl = document.getElementById('pull-cmd-mirror');
  var copyLink = document.querySelector('.pull-cmd-display a[data-copy]');

  if (toMirror) {
    switchEl.classList.add('on');
    prefixLabel.classList.remove('active');
    mirrorLabel.classList.add('active');
    prefixEl.classList.add('hidden');
    mirrorEl.classList.remove('hidden');
    copyLink.setAttribute('data-copy', mirrorEl.textContent);
  } else {
    switchEl.classList.remove('on');
    prefixLabel.classList.add('active');
    mirrorLabel.classList.remove('active');
    prefixEl.classList.remove('hidden');
    mirrorEl.classList.add('hidden');
    copyLink.setAttribute('data-copy', prefixEl.textContent);
  }
}

function togglePullCmd() {
  var switchEl = document.getElementById('pull-cmd-switch');
  if (switchEl.hasAttribute('disabled')) return;
  switchPullCmd(!switchEl.classList.contains('on'));
}
</script>
