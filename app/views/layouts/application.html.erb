<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>广东工业大学开源镜像站</title>

    <%= favicon_link_tag "favicon-32x32.png", sizes: "32x32" %>
    <%= favicon_link_tag "favicon-16x16.png", sizes: "16x16" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
  </head>
  <body class="fade-in">
    <script>
      (function() {
        function applyTheme(mode) {
          var html = document.documentElement;
          html.classList.remove('dark-theme', 'light-manual');
          if (mode === 'dark') {
            html.classList.add('dark-theme');
          } else if (mode === 'light') {
            html.classList.add('light-manual');
          } else {
            if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
              html.classList.add('dark-theme');
            }
          }
        }

        function updateThemeIcon(mode) {
          var btn = document.querySelector('.theme-toggle');
          if (!btn) return;
          btn.querySelector('.icon-sun').style.display = mode === 'light' ? '' : 'none';
          btn.querySelector('.icon-moon').style.display = mode === 'dark' ? '' : 'none';
          btn.querySelector('.icon-auto').style.display = mode === 'auto' ? '' : 'none';
          var labels = { light: '浅色模式', dark: '深色模式', auto: '自动模式（跟随系统）' };
          btn.setAttribute('title', '当前: ' + labels[mode] + ' — 点击切换');
          btn.setAttribute('aria-label', '当前: ' + labels[mode] + ' — 点击切换');
        }

        window.applyTheme = applyTheme;
        window.updateThemeIcon = updateThemeIcon;

        window.cycleTheme = function() {
          var current = localStorage.getItem('theme') || 'auto';
          var next;
          if (current === 'auto') next = 'light';
          else if (current === 'light') next = 'dark';
          else next = 'auto';
          localStorage.setItem('theme', next);
          applyTheme(next);
          updateThemeIcon(next);
        };

        var saved = localStorage.getItem('theme') || 'auto';
        applyTheme(saved);

        if (window.matchMedia) {
          var mq = window.matchMedia('(prefers-color-scheme: dark)');
          mq.addEventListener('change', function() {
            var mode = localStorage.getItem('theme') || 'auto';
            if (mode === 'auto') {
              applyTheme('auto');
            }
          });
        }
      })();
    </script>
    <%= render "header" %>

    <main class="container">
      <%= render "flash" %>
      <%= yield %>
    </main>

    <%= render "footer" %>
  </body>
</html>
