<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>广东工业大学开源镜像站</title>

    <%= favicon_link_tag "favicon-32x32.png", sizes: "32x32" %>
    <%= favicon_link_tag "favicon-16x16.png", sizes: "16x16" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
  </head>
  <body class="fade-in">
    <script>
      (function() {
        // 主题切换动画时长（圆形扩散）
        var THEME_REVEAL_DURATION = 480;
        var systemDarkMedia = window.matchMedia
          ? window.matchMedia('(prefers-color-scheme: dark)')
          : null;

        // 期望的明暗状态。View Transition 的切换回调要等下一帧才执行，
        // 期间 DOM 上还是旧状态，所以判断「明暗有没有变」不能看 DOM，
        // 得看这个变量，否则连续点击会算错。
        var currentThemeIsDark = null;

        function resolveIsDark(mode) {
          return mode === 'dark' || (mode === 'auto' && !!systemDarkMedia && systemDarkMedia.matches);
        }

        function prefersReducedMotion() {
          return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        }

        // 切换按钮的圆心，作为圆形扩散的原点
        function themeToggleOrigin() {
          var button = document.querySelector('.theme-toggle');
          if (!button || !button.getBoundingClientRect) return null;
          var rect = button.getBoundingClientRect();
          if (!rect.width && !rect.height) return null;
          return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
        }

        function setThemeClass(isDark) {
          var html = document.documentElement;
          html.classList.remove('dark-theme', 'light-manual');
          if (isDark) {
            html.classList.add('dark-theme');
          } else {
            html.classList.add('light-manual');
          }
        }

        /**
         * 应用主题。
         * origin 为空或环境不支持时直接切换，不做动画。
         * 注意：「跟随系统」与显式明/暗模式互切时，实际明暗可能根本没变
         * （例如系统是浅色时从 auto 切到 light），此时不应该播动画。
         */
        function applyTheme(mode, origin) {
          var isDark = resolveIsDark(mode);
          var wasDark = currentThemeIsDark === null
            ? document.documentElement.classList.contains('dark-theme')
            : currentThemeIsDark;

          currentThemeIsDark = isDark;
          updateThemeIcon(mode);

          if (isDark === wasDark) {
            // 明暗没变，只同步状态
            setThemeClass(isDark);
            return;
          }

          if (!origin || prefersReducedMotion() ||
              typeof document.startViewTransition !== 'function') {
            setThemeClass(isDark);
            return;
          }

          startThemeReveal(origin);
        }

        // 用 View Transition 的 root 快照做圆形扩散：
        // 旧主题垫底，新主题以按钮为圆心从 0 半径放大到覆盖整个视口。
        function startThemeReveal(origin) {
          var root = document.documentElement;
          var reveal;

          // 关掉元素自身的颜色过渡，否则新快照会拍到过渡中间态的颜色
          root.classList.add('theme-switching');

          try {
            reveal = document.startViewTransition(function() {
              // 读最新的期望状态，连续点击时以最后一次为准
              setThemeClass(currentThemeIsDark);
            });
          } catch (err) {
            root.classList.remove('theme-switching');
            setThemeClass(currentThemeIsDark);
            return;
          }

          function cleanup() {
            root.classList.remove('theme-switching');
          }

          reveal.ready.then(function() {
            // 快照已拍完，可以恢复常规过渡了
            cleanup();

            var x = origin.x;
            var y = origin.y;
            // 需要覆盖到最远的视口角
            var radius = Math.hypot(
              Math.max(x, window.innerWidth - x),
              Math.max(y, window.innerHeight - y)
            );

            root.animate({
              clipPath: [
                'circle(0px at ' + x + 'px ' + y + 'px)',
                'circle(' + radius + 'px at ' + x + 'px ' + y + 'px)'
              ]
            }, {
              duration: THEME_REVEAL_DURATION,
              easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
              pseudoElement: '::view-transition-new(root)'
            });
          }).catch(cleanup);

          // 连续点击时旧过渡会被跳过，这里兜底恢复过渡
          reveal.finished.catch(cleanup);
        }

        function updateThemeIcon(mode) {
          var btn = document.querySelector('.theme-toggle');
          if (!btn) return;
          btn.querySelector('.icon-sun').style.display = mode === 'light' ? '' : 'none';
          btn.querySelector('.icon-moon').style.display = mode === 'dark' ? '' : 'none';
          btn.querySelector('.icon-auto').style.display = mode === 'auto' ? '' : 'none';
          var labels = { light: '浅色模式', dark: '深色模式', auto: '自动模式（跟随系统）' };
          btn.setAttribute('title', '当前: ' + labels[mode] + ' — 点击切换');
          btn.setAttribute('aria-label', '当前: ' + labels[mode] + ' — 点击切换');
        }

        window.applyTheme = applyTheme;
        window.updateThemeIcon = updateThemeIcon;

        window.cycleTheme = function(event) {
          var current = localStorage.getItem('theme') || 'auto';
          var next;
          if (current === 'auto') next = 'light';
          else if (current === 'light') next = 'dark';
          else next = 'auto';
          localStorage.setItem('theme', next);

          // 用被点击的按钮中心做扩散原点
          var origin = null;
          var button = event && (event.currentTarget || event.target);
          if (button && button.getBoundingClientRect) {
            var rect = button.getBoundingClientRect();
            if (rect.width || rect.height) {
              origin = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
            }
          }

          applyTheme(next, origin || themeToggleOrigin());
        };

        var saved = localStorage.getItem('theme') || 'auto';
        applyTheme(saved);

        if (systemDarkMedia && systemDarkMedia.addEventListener) {
          systemDarkMedia.addEventListener('change', function() {
            var mode = localStorage.getItem('theme') || 'auto';
            if (mode === 'auto') {
              applyTheme('auto', themeToggleOrigin());
            }
          });
        }
      })();
    </script>
    <%= render "header" %>

    <main class="container">
      <%= render "flash" %>
      <%= yield %>
    </main>

    <%= render "footer" %>
  </body>
</html>
