<script type="application/json" id="converter-config"><%= @converter_config.to_json.html_safe %></script>

<div class="homepage-layout">
  <div class="homepage-main">
    <% if @projects.any? %>
      <div class="project-grid">
        <% @projects.each do |project| %>
          <div class="island mb-0 project-card">
            <%= link_to project_path(project.name), class: "stretched-link" do %>
              <%= render "shared/icon", name: "arrow-right", size: 0 %>
            <% end %>
            <%= content_tag :div, class: "island-header" do %>
              <%= render "shared/icon", name: "server", size: 28, class: "island-icon" %>
              <div class="island-header-group">
                <span class="text-muted small"><%= project.proxy_cache? ? "代理项目" : "本地项目" %></span>
                <h5 class="island-title mb-0"><%= project.name %></h5>
              </div>
              <% if project.proxy_cache? && project.upstream_registry %>
                <div class="island-header-group" style="margin-left: auto;">
                  <span class="badge badge-dtag"><%= project.upstream_registry.display_name %></span>
                </div>
              <% elsif project.local? %>
                <div class="island-header-group" style="margin-left: auto;">
                  <span class="badge badge-local">本地</span>
                </div>
              <% end %>
            <% end %>
            <div class="island-body">
              <div class="project-stats">
                <div class="project-stat-item">
                  <%= render "shared/icon", name: "box", size: 16 %>
                  <span><%= project.repo_count %> 个仓库</span>
                </div>
                <% if project.quota_hard && project.quota_hard > 0 %>
                  <div class="project-stat-item">
                    <%= render "shared/icon", name: "server", size: 16 %>
                    <span><%= bytes_to_human(project.quota_used) %> / <%= bytes_to_human(project.quota_hard) %></span>
                  </div>
                <% end %>
                <% if project.creation_time.present? %>
                  <div class="project-stat-item">
                    <%= render "shared/icon", name: "info", size: 16 %>
                    <span><%= project.creation_time.to_date.strftime("%Y-%m-%d") %></span>
                  </div>
                <% end %>
              </div>

              <% if project.quota_hard && project.quota_hard > 0 %>
                <div class="quota-bar-wrapper">
                  <div class="quota-bar">
                    <div class="quota-bar-fill quota-<%= project.quota_percentage >= 80 ? 'danger' : project.quota_percentage >= 50 ? 'warning' : 'normal' %>" style="width: <%= [project.quota_percentage, 100].min %>%"></div>
                  </div>
                  <span class="quota-percentage"><%= project.quota_percentage %>%</span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center mt-5">
        <h1 class="cover-heading">暂无代理项目</h1>
        <p class="lead">未找到任何 Harbor Proxy Cache 项目。</p>
      </div>
    <% end %>

    <%= render "shared/pagination", total_pages: @projects.total_pages, current_page: @projects.page, path_helper: :root_path %>
  </div>

  <aside class="homepage-sidebar">
    <%= render "converter" %>
  </aside>

  <button type="button" class="converter-dock" id="converter-dock" title="展开镜像名称转换" aria-label="展开镜像名称转换">
    <%= render "shared/icon", name: "terminal", size: 20 %>
    <span class="converter-dock-label">镜像名称转换</span>
  </button>
</div>

<script>
(function() {
  var STORAGE_KEY = 'converter-collapsed';
  var DURATION = 420;
  var EASE = 'cubic-bezier(0.4, 0, 0.2, 1)';

  var layout = document.querySelector('.homepage-layout');
  var main = layout.querySelector('.homepage-main');
  var sidebar = layout.querySelector('.homepage-sidebar');
  var hideBtn = document.getElementById('converter-hide-btn');
  var dock = document.getElementById('converter-dock');
  var busy = false;

  // 先于首帧恢复收起状态, 避免页面加载时卡片闪一下
  try {
    if (localStorage.getItem(STORAGE_KEY) === '1') layout.classList.add('converter-collapsed');
  } catch (e) {}

  function reducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function save(collapsed) {
    try { localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0'); } catch (e) {}
  }

  // 等 transform 过渡结束; 兜底定时器防止 transitionend 丢失(起止相同或标签页在后台)
  function afterTransition(el, done) {
    var finished = false;
    function finish(e) {
      if (finished || (e && (e.target !== el || e.propertyName !== 'transform'))) return;
      finished = true;
      el.removeEventListener('transitionend', finish);
      done();
    }
    el.addEventListener('transitionend', finish);
    setTimeout(finish, DURATION + 80);
  }

  function animate(el, from, to, done) {
    el.style.transition = 'none';
    el.style.transform = from;
    el.getBoundingClientRect();
    el.style.transition = 'transform ' + DURATION + 'ms ' + EASE;
    el.style.transform = to;
    afterTransition(el, done);
  }

  function resetMotion(el) {
    el.style.transition = '';
    el.style.transform = '';
  }

  // 卡片右移到视口外需要的距离
  function offscreen(rect) {
    return 'translateX(' + Math.ceil(window.innerWidth - rect.left + 24) + 'px)';
  }

  // FLIP: 布局已切换, 项目卡片群从旧位置平滑移到新位置。
  // 桌面端是横向居中/归位, 移动端卡片在列表上方, 是纵向上移/下移
  function flipMain(before, done) {
    var after = main.getBoundingClientRect();
    var dx = before.left - after.left;
    var dy = before.top - after.top;
    if (!dx && !dy) { done(); return; }
    animate(main, 'translate(' + dx + 'px, ' + dy + 'px)', 'translate(0, 0)', done);
  }

  // 两段动画都结束后才收尾
  function whenBoth(done) {
    var pending = 2;
    return function() { if (--pending === 0) done(); };
  }

  var PINNED_PROPS = [ 'position', 'top', 'left', 'width', 'height', 'margin', 'zIndex' ];

  function collapse() {
    if (busy || layout.classList.contains('converter-collapsed')) return;
    save(true);
    if (reducedMotion()) {
      layout.classList.add('converter-collapsed');
      return;
    }
    busy = true;

    var mainBefore = main.getBoundingClientRect();
    var side = sidebar.getBoundingClientRect();
    var box = layout.getBoundingClientRect();

    // 工具卡片脱离文档流并钉在原位, 布局立即切到单栏, 卡片滑出与项目卡片群移动同时进行。
    // 桌面端卡片是 sticky(相对视口), 钉成 fixed 才不会随滚动漂移; 移动端是普通文档流, 用 absolute
    var pinToViewport = getComputedStyle(sidebar).position === 'sticky';
    sidebar.style.position = pinToViewport ? 'fixed' : 'absolute';
    sidebar.style.top = (pinToViewport ? side.top : side.top - box.top) + 'px';
    sidebar.style.left = (pinToViewport ? side.left : side.left - box.left) + 'px';
    sidebar.style.width = side.width + 'px';
    sidebar.style.height = side.height + 'px';
    sidebar.style.margin = '0';
    sidebar.style.zIndex = '5';
    layout.classList.add('converter-collapsed', 'converter-animating');

    var finish = whenBoth(function() {
      PINNED_PROPS.forEach(function(p) { sidebar.style[p] = ''; });
      resetMotion(sidebar);
      resetMotion(main);
      layout.classList.remove('converter-animating');
      busy = false;
    });
    animate(sidebar, 'translateX(0)', offscreen(side), finish);
    flipMain(mainBefore, finish);
  }

  function expand() {
    if (busy || !layout.classList.contains('converter-collapsed')) return;
    save(false);
    if (reducedMotion()) {
      layout.classList.remove('converter-collapsed');
      return;
    }
    busy = true;

    var mainBefore = main.getBoundingClientRect();
    layout.classList.remove('converter-collapsed');
    var side = sidebar.getBoundingClientRect();

    var finish = whenBoth(function() {
      resetMotion(sidebar);
      resetMotion(main);
      busy = false;
    });
    animate(sidebar, offscreen(side), 'translateX(0)', finish);
    flipMain(mainBefore, finish);
  }

  hideBtn.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    collapse();
  });
  dock.addEventListener('click', expand);
})();
</script>
