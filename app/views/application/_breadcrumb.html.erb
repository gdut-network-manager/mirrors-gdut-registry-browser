<%= content_tag :ol, class: "breadcrumb" do %>
  <div class="breadcrumb-item">
    <%= link_to root_path do %>
      <%= render "shared/icon", name: "home", size: 16 %>
    <% end %>
  </div>

  <%= content_tag :div, class: "breadcrumb-item" do %>
    <%= link_to @project.name, project_path(@project.name), data: { tooltip: "代理项目" } %>
  <% end if @project %>

  <%= content_tag :div, class: "breadcrumb-item" do %>
    <%= link_to @repository.relative_name, repository_path(@project.name, @repository.relative_name), data: { tooltip: "仓库" } %>
  <% end if @repository %>

  <%= content_tag :div, class: "breadcrumb-item breadcrumb-tag" do %>
    <% if @tag.name %>
      <%= @tag.name %>
    <% else %>
      <%= @tag.display_name %>
    <% end %>
  <% end if @tag %>
<% end %>
