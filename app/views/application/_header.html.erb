<nav class="navbar">
  <div class="navbar-container">
    <%= link_to root_path, class: "navbar-brand" do %>
      <%= image_tag "icons/gdut-logo.png", alt: "GDUT", width: "42" %>
      <span>广东工业大学开源镜像站容器镜像库</span>
    <% end %>
    <div class="navbar-actions">
      <button class="theme-toggle" aria-label="切换主题" title="切换深色/浅色主题" onclick="
        var html = document.documentElement;
        var isDark = html.classList.contains('dark-theme');
        html.classList.remove('dark-theme', 'light-manual');
        if (isDark) {
          html.classList.add('light-manual');
          localStorage.setItem('theme', 'light');
          this.querySelector('.icon-sun').style.display = 'none';
          this.querySelector('.icon-moon').style.display = '';
        } else {
          html.classList.add('dark-theme');
          localStorage.setItem('theme', 'dark');
          this.querySelector('.icon-sun').style.display = '';
          this.querySelector('.icon-moon').style.display = 'none';
        }
      ">
        <svg class="icon-moon" width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
        </svg>
        <svg class="icon-sun" width="20" height="20" fill="currentColor" viewBox="0 0 20 20" style="display: none;">
          <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/>
        </svg>
      </button>
    </div>
  </div>
</nav>
