<nav class="navbar">
  <div class="navbar-container">
    <%= link_to root_path, class: "navbar-brand" do %>
      <%= image_tag "icons/gdut-logo.png", alt: "GDUT", width: "42" %>
      <span>广东工业大学开源镜像站容器镜像库</span>
    <% end %>
    <div class="navbar-actions">
      <button class="theme-toggle" aria-label="切换主题" title="切换深色/浅色主题" onclick="
        var html = document.documentElement;
        var isDark = html.classList.contains('dark-theme');
        html.classList.remove('dark-theme', 'light-manual');
        if (isDark) {
          html.classList.add('light-manual');
          localStorage.setItem('theme', 'light');
        } else {
          html.classList.add('dark-theme');
          localStorage.setItem('theme', 'dark');
        }
      ">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
        </svg>
      </button>
    </div>
  </div>
</nav>
